{
  "name": "generalstaff-workbench",
  "displayName": "GeneralStaff Workbench",
  "description": "A persistent orchestrator session for directing a GeneralStaff fleet.",
  "version": "0.4.14",
  "publisher": "lerugray",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lerugray/generalstaff-desktop.git",
    "directory": "workbench-extension"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "generalstaff",
    "agents",
    "orchestration",
    "multi-model"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "generalstaff.openCommandDeck",
        "title": "GeneralStaff: Open Command Deck",
        "category": "GeneralStaff"
      },
      {
        "command": "generalstaff.newConversation",
        "title": "GeneralStaff: Focus Orchestrator Session",
        "category": "GeneralStaff"
      },
      {
        "command": "generalstaff.refresh",
        "title": "GeneralStaff: Refresh Fleet",
        "category": "GeneralStaff"
      },
      {
        "command": "generalstaff.openRawTerminal",
        "title": "GeneralStaff: Open Supporting Terminal",
        "category": "GeneralStaff"
      },
      {
        "command": "generalstaff.openWorkshop",
        "title": "GeneralStaff: Open Workshop",
        "category": "GeneralStaff"
      },
      {
        "command": "generalstaff.returnToDesk",
        "title": "GeneralStaff: Return to Desk",
        "category": "GeneralStaff"
      }
    ],
    "keybindings": [
      {
        "command": "generalstaff.openCommandDeck",
        "key": "cmd+shift+g",
        "mac": "cmd+shift+g",
        "win": "ctrl+shift+g",
        "linux": "ctrl+shift+g"
      },
      {
        "command": "generalstaff.returnToDesk",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "generalstaff.deskActive"
      },
      {
        "command": "generalstaff.returnToDesk",
        "key": "ctrl+j",
        "mac": "cmd+j",
        "when": "generalstaff.deskActive"
      },
      {
        "command": "generalstaff.returnToDesk",
        "key": "ctrl+`",
        "mac": "ctrl+`",
        "when": "generalstaff.deskActive"
      },
      {
        "command": "generalstaff.returnToDesk",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "generalstaff.deskActive"
      }
    ],
    "configuration": {
      "title": "GeneralStaff Workbench",
      "properties": {
        "generalstaff.rootPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the private GeneralStaff state repository. Leave blank to discover the existing operator configuration."
        },
        "generalstaff.laneDeskRuntimePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a trusted Lane Desk runtime installed outside the selected GeneralStaff root. Workbench health-probes it before enabling MCP or CLI fallback transport."
        },
        "generalstaff.defaultSeat": {
          "type": "string",
          "enum": [
            "orchestrate",
            "build",
            "review",
            "verify",
            "assist"
          ],
          "default": "orchestrate",
          "description": "The job-shaped seat selected for new conversations."
        },
        "generalstaff.openOnLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Open the Command Deck when a new Workbench window starts."
        },
        "generalstaff.immersiveMode": {
          "type": "boolean",
          "default": true,
          "description": "Arrive at the desk: hide VS Code sidebars, the activity bar, and the panel so the session fills the window. Open workshop when you want the editor tools."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && node --check media/workbench.js && npm run test && npm run compile",
    "probe:codex-resume-boundary": "node --import tsx scripts/probe-codex-resume-boundary.ts",
    "probe:claude-readonly-boundary": "node --import tsx scripts/probe-claude-readonly-boundary.ts",
    "probe:general-command": "node --import tsx scripts/probe-general-command.ts",
    "package": "npx @vscode/vsce package --no-dependencies",
    "package:distribution": "npx @vscode/vsce package --no-dependencies --out ../distribution/generalstaff-workbench.vsix"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
